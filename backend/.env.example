# =============================================================================
# wow! expert - backend configuration
#
# Copy to .env and fill in the secrets. Never commit the completed file.
#   cp .env.example .env
# =============================================================================

# --- Application -------------------------------------------------------------
ENVIRONMENT=local                 # local | test | staging | production
DEBUG=true
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                    # true in production for structured logs

# REQUIRED. Signs JWTs and derives the token-encryption key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-at-least-32-random-characters

# Optional. Dedicated key for encrypting Battle.net refresh tokens at rest.
# Defaults to a key derived from SECRET_KEY; set it explicitly to rotate
# JWT signing without invalidating every stored Battle.net grant.
# BLIZZARD_TOKEN_ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=12

# Comma-separated. The first entry is where OAuth redirects the user back to.
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wowexpert
POSTGRES_PASSWORD=wowexpert
POSTGRES_DB=wowexpert
# Overrides the parts above when set (as docker-compose does).
# DATABASE_URL=postgresql+asyncpg://wowexpert:wowexpert@localhost:5432/wowexpert
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_ECHO=false

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=300

# --- Battle.net --------------------------------------------------------------
# Create a client at https://develop.battle.net/access/clients
# The redirect URI below must match the client's configuration exactly.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us                # us | eu | kr | tw | cn
BLIZZARD_LOCALE=en_US
BLIZZARD_SCOPES=openid wow.profile
BLIZZARD_REDIRECT_URI=http://localhost:8000/api/v1/blizzard/oauth/callback

# Outbound request tuning.
BLIZZARD_TIMEOUT_SECONDS=15.0
BLIZZARD_MAX_RETRIES=3
BLIZZARD_MAX_CONCURRENCY=10       # parallel calls within one sync

# Response cache lifetimes, in seconds.
BLIZZARD_STATIC_CACHE_TTL=86400   # realms, items: changes only on patch days
BLIZZARD_PROFILE_CACHE_TTL=900    # character data: refreshed more eagerly

# --- Scheduled synchronization -----------------------------------------------
SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=3600        # how often to look for stale accounts
SYNC_STALE_AFTER_HOURS=168        # one week: the weekly sync cadence
SYNC_BATCH_SIZE=50                # accounts processed per sweep

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- AI provider -------------------------------------------------------------
AI_PROVIDER=null                  # null (offline stub) | openai
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30.0
OPENAI_API_KEY=

# --- Knowledge engine (retrieval-augmented guidance) --------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30.0
KNOWLEDGE_CHUNK_TARGET_TOKENS=512
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=64
KNOWLEDGE_DEFAULT_TOP_K=8
KNOWLEDGE_COMMERCIAL_MODE=false
KNOWLEDGE_REFRESH_INTERVAL_HOURS=168
